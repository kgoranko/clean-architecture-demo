@page
@{
    ViewData["Title"] = "Customer Sync to External CRM";
}

<section class="page-hero page-hero--green mb-4">
    <a asp-page="/Index" class="back-link">
        <i class="bi bi-arrow-left"></i>
        <span>Back to overview</span>
    </a>

    <div class="page-hero__content">
        <div class="page-hero__copy">
            <span class="eyebrow">Guide 5</span>
            <h1>Customer Sync to External CRM</h1>
            <p>
                A user or scheduler triggers customer synchronization. Application decides the workflow, Domain decides whether the customer is ready to sync,
                and Infrastructure performs the outbound HTTP call through a dedicated CRM client.
            </p>
        </div>

        <div class="page-hero__aside">
            <span class="info-chip">Outbound HTTP stays behind a client abstraction</span>
            <span class="info-chip">Domain owns sync eligibility and post-sync state</span>
            <span class="info-chip">Retries and client configuration remain in Infrastructure</span>
        </div>
    </div>
</section>

<div class="row g-3 align-items-start">
    <div class="col-xl-6">
        <section class="surface-card surface-card--green">
            <div class="surface-card__header">
                <div>
                    <span class="section-kicker">Orchestration</span>
                    <h2>Application method</h2>
                </div>
                <div class="icon-badge">
                    <i class="bi bi-journal-code"></i>
                </div>
            </div>

            <p class="surface-card__intro">
                Informational sample only. The point here is to separate the business decision to sync from the concrete HTTP mechanics that talk to the CRM.
            </p>

            <pre class="orchestration-code"><code>internal sealed class CustomerCrmSyncService(
    ICustomerRepository customerRepository,
    ICrmClient crmClient,
    IDateTimeProvider dateTimeProvider,
    ILogger&lt;CustomerCrmSyncService&gt; logger) : ICustomerCrmSyncService, IScopedService
{
    public async Task&lt;Result&gt; SyncAsync(
        SyncCustomerToCrmRequest request,
        CancellationToken cancellationToken = default)
    {
        logger.LogInformation(
            "Syncing customer {CustomerId} to CRM",
            request.CustomerId);

        // Step 1: load the aggregate from persistence.
        Customer? customer = await customerRepository.GetByIdAsync(
            request.CustomerId,
            cancellationToken);

        if (customer is null)
        {
            return Result.Failure(CustomerErrors.NotFound(request.CustomerId));
        }

        // Step 2: let the aggregate decide whether sync is allowed.
        Result readinessResult = customer.EnsureReadyForCrmSync();
        if (readinessResult.IsFailure)
        {
            return readinessResult;
        }

        // Step 3: shape an outbound DTO for the external system.
        CrmUpsertRequest payload = CrmUpsertRequest.From(customer);

        // Step 4: call the external API through Infrastructure.
        Result&lt;CrmUpsertResponse&gt; syncResult = await crmClient.UpsertCustomerAsync(
            payload,
            cancellationToken);

        if (syncResult.IsFailure)
        {
            return Result.Failure(syncResult.Error);
        }

        // Step 5: update domain state after success.
        Result markSyncedResult = customer.MarkCrmSynchronized(
            syncResult.Value.ExternalId,
            dateTimeProvider.UtcNow);

        if (markSyncedResult.IsFailure)
        {
            return markSyncedResult;
        }

        await customerRepository.SaveAsync(customer, cancellationToken);

        return Result.Success();
    }
}</code></pre>

            <div class="context-note">
                Application owns the sequence and the failure handling. The CRM payload and HTTP call are technical integration details hidden behind <code>ICrmClient</code>.
            </div>
        </section>
    </div>

    <div class="col-xl-6">
        <div class="d-grid gap-3">
            <section class="surface-card surface-card--muted mermaid-card">
                <div class="surface-card__header">
                    <div>
                        <span class="section-kicker">Lane diagram</span>
                        <h2>Request path by layer</h2>
                    </div>
                    <div class="icon-badge">
                        <i class="bi bi-bezier2"></i>
                    </div>
                </div>

                <p class="surface-card__intro">
                    The CRM call is important to the use case, but the HTTP transport, base address, auth headers, and retry policy are still infrastructure concerns.
                </p>

                <div class="mermaid-frame">
                    <div class="mermaid">
sequenceDiagram
    autonumber
    actor P as Presentation
    participant A as Application
    participant D as Domain
    participant I as Infrastructure

    P->>A: Sync customer request
    A->>I: Load customer
    I-->>A: Aggregate data
    A->>D: Ensure ready for CRM sync
    D-->>A: Allowed
    A->>A: Build CRM payload
    A->>I: Upsert customer via API client
    I-->>A: External CRM id
    A->>D: Mark synchronized
    D-->>A: Aggregate updated
    A->>I: Save customer
    I-->>A: Persisted
    A-->>P: Return result
                    </div>
                </div>
            </section>

            <section class="surface-card surface-card--muted">
                <div class="surface-card__header">
                    <div>
                        <span class="section-kicker">Step explanation</span>
                        <h2>Why each step goes to that layer</h2>
                    </div>
                    <div class="icon-badge">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <div class="step-card step-header">
                        <div class="step-card__icon">
                            <i class="bi bi-1-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 1: load the aggregate from persistence</strong>
                            <span>This goes to <strong>Infrastructure</strong> because loading the customer requires a repository, database access, and persistence tooling. Those are external dependencies, not domain rules.</span>
                        </div>
                    </div>

                    <div class="step-card step-header">
                        <div class="step-card__icon">
                            <i class="bi bi-2-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 2: let the aggregate decide whether sync is allowed</strong>
                            <span>This goes to <strong>Domain</strong> because sync readiness is a business rule. The customer entity decides whether its state is valid for synchronization.</span>
                        </div>
                    </div>

                    <div class="step-card step-success">
                        <div class="step-card__icon">
                            <i class="bi bi-3-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 3: shape an outbound DTO for the external system</strong>
                            <span>This belongs to <strong>Application</strong> because it prepares use-case data for an integration boundary. It is orchestration and mapping, not the domain rule itself and not yet the technical HTTP call.</span>
                        </div>
                    </div>

                    <div class="step-card step-error">
                        <div class="step-card__icon">
                            <i class="bi bi-4-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 4: call the external API through Infrastructure</strong>
                            <span>This goes to <strong>Infrastructure</strong> because HTTP transport, authentication, serialization, retries, and client libraries are all technical integration concerns.</span>
                        </div>
                    </div>

                    <div class="step-card step-success">
                        <div class="step-card__icon">
                            <i class="bi bi-5-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 5: update domain state after success</strong>
                            <span>This goes to <strong>Domain</strong> because marking the customer as synchronized changes business state. The entity should own the rule for that transition.</span>
                        </div>
                    </div>

                    <div class="step-card step-error">
                        <div class="step-card__icon">
                            <i class="bi bi-6-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 6: persist the updated customer</strong>
                            <span>This goes to <strong>Infrastructure</strong> because saving the post-sync state is persistence work backed by database or storage technology.</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

