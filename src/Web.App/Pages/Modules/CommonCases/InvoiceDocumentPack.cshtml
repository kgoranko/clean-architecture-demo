@page
@{
    ViewData["Title"] = "Invoice Export Pack";
}

<section class="page-hero page-hero--cyan mb-4">
    <a asp-page="/Index" class="back-link">
        <i class="bi bi-arrow-left"></i>
        <span>Back to overview</span>
    </a>

    <div class="page-hero__content">
        <div class="page-hero__copy">
            <span class="eyebrow">Guide 2</span>
            <h1>Invoice Export Pack</h1>
            <p>
                A user requests an invoice pack. Application loads the aggregate and coordinates the export, Domain decides whether export is allowed,
                and Infrastructure generates PDF, Word, and Excel files before storing them.
            </p>
        </div>

        <div class="page-hero__aside">
            <span class="info-chip">Domain decides exportability</span>
            <span class="info-chip">Generators stay behind Infrastructure interfaces</span>
            <span class="info-chip">File system or blob storage remains outside Application</span>
        </div>
    </div>
</section>

<div class="row g-3 align-items-start">
    <div class="col-xl-6">
        <section class="surface-card surface-card--cyan">
            <div class="surface-card__header">
                <div>
                    <span class="section-kicker">Orchestration</span>
                    <h2>Application method</h2>
                </div>
                <div class="icon-badge">
                    <i class="bi bi-journal-code"></i>
                </div>
            </div>

            <p class="surface-card__intro">
                Informational sample only. The method shape mirrors the repo's application-service style, but no actual generators or storage integrations are implemented here.
            </p>

            <pre class="orchestration-code"><code>internal sealed class InvoiceExportService(
    IInvoiceRepository invoiceRepository,
    IPdfDocumentGenerator pdfDocumentGenerator,
    IWordDocumentGenerator wordDocumentGenerator,
    ISpreadsheetDocumentGenerator spreadsheetDocumentGenerator,
    IFileStorage fileStorage,
    IDateTimeProvider dateTimeProvider,
    ILogger&lt;InvoiceExportService&gt; logger) : IInvoiceExportService, IScopedService
{
    public async Task&lt;Result&lt;DocumentPackResponse&gt;&gt; ExportInvoicePackAsync(
        ExportInvoicePackRequest request,
        CancellationToken cancellationToken = default)
    {
        logger.LogInformation(
            "Exporting invoice pack for {InvoiceId}",
            request.InvoiceId);

        // Step 1: load the aggregate from persistence.
        Invoice? invoice = await invoiceRepository.GetByIdAsync(
            request.InvoiceId,
            cancellationToken);

        if (invoice is null)
        {
            return Result.Failure&lt;DocumentPackResponse&gt;(
                InvoiceErrors.NotFound(request.InvoiceId));
        }

        // Step 2: let the aggregate decide whether export is allowed.
        Result exportableResult = invoice.EnsureExportable();
        if (exportableResult.IsFailure)
        {
            return Result.Failure&lt;DocumentPackResponse&gt;(exportableResult.Error);
        }

        // Step 3: shape one application export model.
        InvoiceExportModel exportModel = InvoiceExportModel.From(invoice);

        // Step 4: call infrastructure generators.
        byte[] pdfBytes = await pdfDocumentGenerator.GenerateAsync(
            exportModel,
            cancellationToken);

        byte[] wordBytes = await wordDocumentGenerator.GenerateAsync(
            exportModel,
            cancellationToken);

        byte[] spreadsheetBytes = await spreadsheetDocumentGenerator.GenerateAsync(
            exportModel,
            cancellationToken);

        // Step 5: write the generated pack to storage.
        string storagePath = await fileStorage.SavePackAsync(
            invoice.Id,
            pdfBytes,
            wordBytes,
            spreadsheetBytes,
            cancellationToken);

        // Step 6: update the aggregate after a successful export.
        invoice.MarkDocumentsGenerated(dateTimeProvider.UtcNow);
        await invoiceRepository.SaveAsync(invoice, cancellationToken);

        return Result.Success(new DocumentPackResponse(storagePath));
    }
}</code></pre>

            <div class="context-note">
                Creating files is not domain behavior. The business behavior is <strong>decide whether this invoice may be exported</strong> and
                <strong>record that export happened</strong>. The byte generation and storage writes remain technical infrastructure details.
            </div>
        </section>
    </div>

    <div class="col-xl-6">
        <div class="d-grid gap-3">
            <section class="surface-card surface-card--muted mermaid-card">
                <div class="surface-card__header">
                    <div>
                        <span class="section-kicker">Lane diagram</span>
                        <h2>Request path by layer</h2>
                    </div>
                    <div class="icon-badge">
                        <i class="bi bi-bezier2"></i>
                    </div>
                </div>

                <p class="surface-card__intro">
                    The aggregate stays responsible for the business gate, while document rendering and file writes remain outbound technical work.
                </p>

                <div class="mermaid-frame">
                    <div class="mermaid">
sequenceDiagram
    autonumber
    actor P as Presentation
    participant A as Application
    participant D as Domain
    participant I as Infrastructure

    P->>A: Export invoice pack request
    A->>I: Load invoice
    I-->>A: Aggregate data
    A->>D: Ensure exportable
    D-->>A: Allowed
    A->>A: Build export model
    A->>I: Generate PDF
    I-->>A: PDF bytes
    A->>I: Generate Word
    I-->>A: Word bytes
    A->>I: Generate Excel
    I-->>A: Spreadsheet bytes
    A->>I: Save document pack
    I-->>A: Storage path
    A->>D: Mark documents generated
    D-->>A: Aggregate updated
    A->>I: Save invoice
    I-->>A: Persisted
    A-->>P: Return result
                    </div>
                </div>
            </section>

            <section class="surface-card surface-card--muted">
                <div class="surface-card__header">
                    <div>
                        <span class="section-kicker">Step explanation</span>
                        <h2>Why each step goes to that layer</h2>
                    </div>
                    <div class="icon-badge">
                        <i class="bi bi-diagram-3"></i>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <div class="step-card step-header">
                        <div class="step-card__icon">
                            <i class="bi bi-1-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 1: load the aggregate from persistence</strong>
                            <span>This goes to <strong>Infrastructure</strong> because reading invoice state from a database or store is an IO concern implemented through repositories and persistence tooling.</span>
                        </div>
                    </div>

                    <div class="step-card step-header">
                        <div class="step-card__icon">
                            <i class="bi bi-2-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 2: let the aggregate decide whether export is allowed</strong>
                            <span>This goes to <strong>Domain</strong> because exportability is a business rule. The invoice entity decides whether its current state allows export.</span>
                        </div>
                    </div>

                    <div class="step-card step-success">
                        <div class="step-card__icon">
                            <i class="bi bi-3-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 3: shape one application export model</strong>
                            <span>This belongs to <strong>Application</strong> because it is orchestration and data preparation for the use case. It is not a domain invariant and not a technical transport detail yet.</span>
                        </div>
                    </div>

                    <div class="step-card step-error">
                        <div class="step-card__icon">
                            <i class="bi bi-4-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 4: call infrastructure generators</strong>
                            <span>This goes to <strong>Infrastructure</strong> because PDF, Word, and Excel generation use external libraries and document formats. QuestPDF and Open XML are technical adapters, not domain logic.</span>
                        </div>
                    </div>

                    <div class="step-card step-error">
                        <div class="step-card__icon">
                            <i class="bi bi-5-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 5: write the generated pack to storage</strong>
                            <span>This goes to <strong>Infrastructure</strong> because writing bytes to a file system or blob store is a storage side effect. It depends on external resources and concrete APIs.</span>
                        </div>
                    </div>

                    <div class="step-card step-success">
                        <div class="step-card__icon">
                            <i class="bi bi-6-circle"></i>
                        </div>
                        <div class="step-card__content">
                            <strong>Step 6: update the aggregate after a successful export</strong>
                            <span>This goes to <strong>Domain</strong> because marking the invoice as exported changes business state. The entity should own that rule, while the later save remains Infrastructure.</span>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

