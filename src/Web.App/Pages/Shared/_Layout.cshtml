@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    string NavState(string page) =>
        string.Equals(currentPage, page, System.StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clean Architecture Demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg app-nav">
        <div class="container app-shell">
            <a class="navbar-brand app-brand" asp-page="/Index">
                <span class="brand-mark">
                    <i class="bi bi-layers"></i>
                </span>
                <span class="brand-copy">
                    <span class="brand-title">Clean Architecture Demo</span>
                    <small>Architecture demo workspace</small>
                </span>
            </a>

            <button class="navbar-toggler app-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav app-nav-links me-auto">
                    <li class="nav-item">
                        <a class="nav-link nav-link-pill @NavState("/Index")" asp-page="/Index">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Overview</span>
                        </a>
                    </li>
                </ul>

                <button id="themeToggle" class="btn app-theme-toggle" type="button" title="Toggle dark/light mode">
                    <i class="bi bi-sun-fill" id="themeIcon"></i>
                    <span class="theme-toggle-label">Theme</span>
                </button>
            </div>
        </div>
    </nav>

    <main class="app-main">
        <div class="container app-shell py-3 py-lg-4">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container app-shell">
            <div class="footer-copy">
                <span>Clean Architecture Demo</span>
                <small>Demo workspace for clean architecture implementation patterns across presentation, application, domain, and infrastructure layers.</small>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
